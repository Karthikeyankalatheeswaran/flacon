{
  "name": "flacon",
  "version": "0.4.0",
  "description": "Lossless, bottled. Lossless-first music player with a floating island.",
  "private": true,
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "rebuild:native": "node scripts/rebuild-native.mjs",
    "package:dir": "electron-vite build && electron-builder --dir --arm64 -c.mac.identity=null && codesign --force --deep -s - dist/mac-arm64/Flacon.app",
    "package": "electron-vite build && node scripts/check-ffmpeg-license.mjs && electron-builder",
    "check:ffmpeg": "node scripts/check-ffmpeg-license.mjs",
    "check:ffmpeg:all": "node scripts/check-ffmpeg-license.mjs --all",
    "check:signing": "node scripts/check-signing.mjs --env",
    "package:release": "npm run check:ffmpeg:all && npm run check:signing && electron-vite build && electron-builder --mac --win -c.mac.notarize=true",
    "test:e2e": "electron-vite build && vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.25",
    "@types/yauzl": "^3.4.0",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^4.0.3",
    "electron-updater": "^6.8.11",
    "ffmpeg-static": "^5.3.0",
    "framer-motion": "^11.18.2",
    "music-metadata": "^11.16.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.14.0",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^2.3.0",
    "playwright-core": "^1.64.1",
    "resedit": "^3.1.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "author": "Flacon contributors"
}
